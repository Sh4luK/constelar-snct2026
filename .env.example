# Copie para .env e troque TODAS as senhas (o ./iniciar.sh faz isso sozinho).
APP_PORT=8080

DB_NAME=constelar
DB_USER=constelar
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# Administrador criado/atualizado a cada subida. Senha com 10 caracteres ou mais.
ADMIN_EMAIL=admin@constelar.local
ADMIN_PASSWORD=troque-esta-senha-admin

# E-mail de contato exibido na página de privacidade (opcional).
CONTATO_EMAIL=

# Imagem do banco. Em computadores antigos (processador sem SSE4.2) o MySQL 8.4
# não inicia; descomente a linha abaixo para usar o MariaDB, que é compatível.
# DB_IMAGE=mariadb:11.4
